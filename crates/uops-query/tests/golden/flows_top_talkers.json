{
  "signal": "flow",
  "time": {
    "start": "2026-09-01T00:00:00Z",
    "end": "2026-09-02T00:00:00Z"
  },
  "resources": {
    "type": "all"
  },
  "aggregations": [
    {
      "func": "sum",
      "field": { "field": "bytes" },
      "alias": "bytes"
    }
  ],
  "group_by": [
    { "field": "time_bucket", "seconds": 300 },
    { "field": "src_address" },
    { "field": "dst_address" },
    { "field": "sampling_rate" }
  ],
  "order_by": [
    { "key": { "by": "alias", "alias": "bytes" }, "desc": true }
  ],
  "limit": 50
}
