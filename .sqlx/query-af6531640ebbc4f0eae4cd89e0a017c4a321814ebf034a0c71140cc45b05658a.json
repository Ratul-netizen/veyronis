{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT u.id, u.email, u.display_name,\n                   r.role AS \"role: Role\",\n                   u.disabled_at IS NOT NULL AS \"disabled!\"\n              FROM user_tenant_role r\n              JOIN app_user u ON u.id = r.user_id\n             WHERE r.tenant_id = $1\n             ORDER BY lower(u.email)\n            ",
