{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, tenant_id, runbook_id, failure,\n                   finished_at AS \"finished_at!\"\n              FROM runbook_run\n             WHERE state = 'failed'\n               AND finished_at > now() - make_interval(secs => $1)\n             ORDER BY finished_at\n            ",
